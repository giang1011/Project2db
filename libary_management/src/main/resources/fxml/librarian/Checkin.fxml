<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.CheckinController" 
      spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">
      

    
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Column 1: Scan and Information -->
        <VBox spacing="15" prefWidth="450" HBox.hgrow="ALWAYS">
            
            <!-- Search Member Section -->
            <VBox styleClass="card" spacing="15">
                <Label text="Search Member" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtMemberCode" promptText="Enter member code..." prefWidth="300" HBox.hgrow="ALWAYS" style="-fx-background-radius: 5;"/>
                    <Button text="Search" fx:id="btnSearchMember" styleClass="accent"/>
                </HBox>
                
                <Label fx:id="lblBorrowedCount" text="Currently borrowing: 0 books" style="-fx-text-fill: -color-fg-muted;"/>
                
                <TableView fx:id="tblBorrowedBooks" prefHeight="200" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colImage" text="Image" prefWidth="100"/>
                        <TableColumn fx:id="colBarcode" text="Barcode" prefWidth="100"/>
                        <TableColumn fx:id="colTitle" text="Title" prefWidth="200"/>
                        <TableColumn fx:id="colDueDate" text="Due Date" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
            
            <!-- Borrowed Information Section -->
            <VBox styleClass="card" spacing="15" fx:id="boxBookDetails" disable="true" VBox.vgrow="ALWAYS">
                <Label text="Borrowed Information" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                
                <GridPane hgap="20" vgap="15" style="-fx-padding: 10 0;">
                    <Label text="Book Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: -color-fg-muted;"/>
                    <Label fx:id="lblBookTitle" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    
                    <Label text="Borrowed by:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: -color-fg-muted;"/>
                    <Label fx:id="lblBorrowerName" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    
                    <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: -color-fg-muted;"/>
                    <Label fx:id="lblDueDate" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    
                    <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: -color-fg-muted;"/>
                    <Label fx:id="lblOverdueStatus" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: -color-danger-emphasis;"/>
                </GridPane>
            </VBox>
        </VBox>
        
        <!-- Column 2: Return Information & Fines -->
        <VBox spacing="15" prefWidth="350" minWidth="300" styleClass="card" fx:id="boxFines" disable="true">
            <Label text="Return Information" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <VBox spacing="5">
                <Label text="Condition *" style="-fx-text-fill: -color-fg-muted; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbCondition" promptText="Select condition (GOOD...)" maxWidth="Infinity" style="-fx-background-radius: 5;"/>
            </VBox>
            
            <VBox fx:id="boxDamageNotes" spacing="5" managed="false" visible="false">
                <Label text="Damage/Lost Notes" style="-fx-text-fill: -color-fg-muted; -fx-font-weight: bold;"/>
                <TextArea fx:id="txtNotes" prefRowCount="3" wrapText="true" style="-fx-background-radius: 5;"/>
            </VBox>
            
            <Separator style="-fx-padding: 10 0;"/>
            
            <VBox alignment="CENTER" spacing="5">
                <Label text="Calculated Fines" style="-fx-text-fill: -color-fg-muted;"/>
                <Label fx:id="lblFineAmount" text="0 VND" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: -color-danger-emphasis;"/>
                <Label fx:id="lblFineReason" text="(Returned on time)" style="-fx-text-fill: -color-fg-muted;"/>
                <Button text="Pay Fine Now" fx:id="btnPayFine" styleClass="accent" disable="true" style="-fx-margin-top: 10;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Return" fx:id="btnConfirmCheckin" styleClass="success" maxWidth="Infinity" prefHeight="40" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        </VBox>
    </HBox>
</VBox>
