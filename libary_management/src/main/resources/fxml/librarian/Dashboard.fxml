<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.DashboardController" 
      spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">
      
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Dashboard" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Add Member" onAction="#handleAddMember" style="-fx-background-color: #1C64F2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
        <Button text="Add Book" onAction="#handleAddBook" style="-fx-background-color: #1C64F2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
    </HBox>
    
    <HBox spacing="20" alignment="CENTER_LEFT">
        <!-- Card 1 -->
        <VBox style="-fx-background-color: #1C64F2; -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(28,100,242,0.3), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Borrowing Books" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblBorrowing" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="📚" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.4);"/>
            </HBox>
        </VBox>
        <!-- Card 2 -->
        <VBox style="-fx-background-color: #E02424; -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(224,36,36,0.3), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Overdue Books" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblOverdue" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="⚠️" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.4);"/>
            </HBox>
        </VBox>
        <!-- Card 3 -->
        <VBox style="-fx-background-color: #057A55; -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(5,122,85,0.3), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Pending Profiles" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblPendingProfiles" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="👥" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.4);"/>
            </HBox>
        </VBox>
        <!-- Card 4 -->
        <VBox style="-fx-background-color: #7E3AF2; -fx-background-radius: 8px; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(126,58,242,0.3), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Unpaid Fines" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblUnpaidFines" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="💰" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.4);"/>
            </HBox>
        </VBox>
    </HBox>
    
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15" style="-fx-padding: 0;">
        <Label text="Today's Borrow Transactions" styleClass="section-title" style="-fx-padding: 20 20 0 20;"/>
        <TableView fx:id="recentTransactionsTable" VBox.vgrow="ALWAYS" style="-fx-border-color: transparent;">
            <columns>
                <TableColumn fx:id="colTransId" text="Transaction ID" prefWidth="120"/>
                <TableColumn fx:id="colMemberCode" text="Member Code" prefWidth="120"/>
                <TableColumn fx:id="colMemberName" text="Member Name" prefWidth="200"/>
                <TableColumn fx:id="colBooksCount" text="Books Borrowed" prefWidth="120"/>
                <TableColumn fx:id="colBorrowDate" text="Borrow Date" prefWidth="150"/>
                <TableColumn fx:id="colProcessedBy" text="Processed By" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
