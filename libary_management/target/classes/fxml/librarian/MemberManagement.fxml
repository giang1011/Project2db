<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: transparent;" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.library.controller.MemberManagementController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <top>
        <VBox spacing="20" BorderPane.alignment="CENTER" style="-fx-padding: 0 0 20 0;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Members" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #111827;"/>
            </HBox>

            <!-- Action Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="+ Add Member" style="-fx-background-color: #1C64F2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="🔄 Refresh" onAction="#handleRefresh" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 15;">
                    <Label text="🔍" style="-fx-text-fill: -color-fg-muted;"/>
                    <TextField fx:id="txtSearch" promptText="Search by name, code..." style="-fx-background-color: transparent; -fx-border-color: transparent;" prefWidth="200"/>
                </HBox>
                <ComboBox fx:id="cmbMemberType" promptText="Member Type" prefWidth="130" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 5;"/>
                <ComboBox fx:id="cmbStatus" promptText="Status" prefWidth="120" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 5;"/>
                <Button text="Filter" fx:id="btnFilter" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 5; -fx-padding: 5 15; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="card" VBox.vgrow="ALWAYS" BorderPane.alignment="CENTER" style="-fx-padding: 0;">
            <TableView fx:id="tableMembers" VBox.vgrow="ALWAYS" style="-fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colMemberCode" text="Member Code" prefWidth="130" minWidth="120" resizable="false"/>
                    <TableColumn fx:id="colFullName" text="Full Name" prefWidth="250" minWidth="200" resizable="false"/>
                    <TableColumn fx:id="colMemberType" text="Member Type" prefWidth="110" minWidth="100" resizable="false"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="130" minWidth="120" resizable="false"/>
                    <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="130" minWidth="120" resizable="false"/>
                    <TableColumn fx:id="colEndDate" text="End Date" prefWidth="130" minWidth="120" resizable="false"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="280" minWidth="260" resizable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 15px; -fx-border-color: #E5E7EB transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <Label text="Total: " style="-fx-text-fill: -color-fg-muted; -fx-font-weight: bold;"/>
                <Label fx:id="lblTotalMembers" text="0" style="-fx-text-fill: -color-fg-muted; -fx-font-weight: bold;"/>
                <Label text=" members" style="-fx-text-fill: -color-fg-muted; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
