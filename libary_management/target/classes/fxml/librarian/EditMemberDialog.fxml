<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.EditMemberDialogController"
      spacing="15" style="-fx-padding: 20;">

    <Label text="Sửa Thông Tin Độc Giả" styleClass="section-title"/>

    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
        </columnConstraints>

        <!-- Mã độc giả (Readonly) -->
        <Label text="Mã độc giả:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtMemberCode" editable="false" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Tên -->
        <Label text="Họ và tên:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtFullName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Email -->
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- SĐT -->
        <Label text="Số điện thoại:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Địa chỉ -->
        <Label text="Địa chỉ:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtAddress" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Hủy" fx:id="btnCancel" onAction="#handleCancel"/>
        <Button text="Lưu thay đổi" fx:id="btnSave" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
